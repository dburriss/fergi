   "ctx": null,
   "expect": {
    "kind": "value",
    "value": 0.30000000000000004
   }
  },
  {
   "id": "bigint-passthru",
   "expr": "a",
   "ctx": {
    "a": 9007199254740993
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": 9007199254740992
    },
    "python": {
     "kind": "value",
     "value": 9007199254740993
    },
    "dotnet": {
     "kind": "value",
     "value": 9007199254740993
    }
   },
   "note": "JS numbers are doubles, so an int above 2^53 is rounded on the way in. Python and .NET keep it exact."
  },
  {
   "id": "bigint-add0",
   "expr": "a + 0",
   "ctx": {
    "a": 9007199254740993
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": 9007199254740992
    },
    "python": {
     "kind": "value",
     "value": 9007199254740992
    },
    "dotnet": {
     "kind": "value",
     "value": 9007199254740993
    }
   },
   "note": "Arithmetic on ints above 2^53: JS and Python compute with doubles, .NET with exact 64-bit ints."
  },
  {
   "id": "bigint-add1",
   "expr": "a + 1",
   "ctx": {
    "a": 9007199254740993
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": 9007199254740992
    },
    "python": {
     "kind": "value",
     "value": 9007199254740992
    },
    "dotnet": {
     "kind": "value",
     "value": 9007199254740994
    }
   },
   "note": "Arithmetic on ints above 2^53: JS and Python compute with doubles, .NET with exact 64-bit ints."
  },
  {
   "id": "int64max",
   "expr": "a",
   "ctx": {
    "a": 9223372036854775807
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": 9223372036854776000
    },
    "python": {
     "kind": "value",
     "value": 9223372036854775807
    },
    "dotnet": {
     "kind": "value",
     "value": 9223372036854775807
    }
   },
   "note": "JS rounds int64 max to a double; Python and .NET keep it exact."
  },
  {
   "id": "mul-large",
   "expr": "3037000500 * 3037000500",
   "ctx": null,
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": 9223372037000250000
    },
    "python": {
     "kind": "value",
     "value": 9223372037000249344
    },
    "dotnet": {
     "kind": "value",
     "value": 9223372037000250000
    }
   },
   "note": "The same double. Python prints its exact digits, JS and .NET the shortest decimal that round-trips."
  },
