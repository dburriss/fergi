   "ctx": null,
   "expect": {
    "kind": "value",
    "value": 3.5
   }
  },
  {
   "id": "int-div-exact",
   "expr": "6 / 2",
   "ctx": null,
   "expect": {
    "kind": "value",
    "value": 3
   }
  },
  {
   "id": "float-add",
