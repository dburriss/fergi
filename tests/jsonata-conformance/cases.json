   "ctx": {
    "first": "Ada",
    "last": "L"
   },
   "expect": {
    "kind": "value",
    "value": "Ada L"
   }
  },
  {
   "id": "int-add",
   "expr": "1 + 2",
   "ctx": null,
   "expect": {
    "kind": "value",
    "value": 3
   }
  },
  {
   "id": "int-div",
