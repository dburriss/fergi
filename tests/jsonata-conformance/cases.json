  {
   "id": "length-emoji",
   "expr": "$length(s)",
   "ctx": {
    "s": "a😀b"
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": 3
    },
    "python": {
     "kind": "value",
     "value": 3
    },
    "dotnet": {
     "kind": "value",
     "value": 4
    }
   },
   "note": "$length counts characters in JS and Python, UTF-16 code units in .NET (a known difference of the port)."
  },
  {
   "id": "substring-emoji",
   "expr": "$substring(s,1,1)",
   "ctx": {
    "s": "a😀b"
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": "😀"
    },
    "python": {
     "kind": "value",
     "value": "😀"
    },
    "dotnet": {
     "kind": "error",
     "code": "ArgumentException"
    }
   },
   "note": "On a non-BMP character .NET splits the surrogate pair (here it throws ArgumentException); JS and Python return the character."
  },
  {
   "id": "upper-unicode",
   "expr": "$uppercase(s)",
   "ctx": {
    "s": "straße"
   },
   "divergent": true,
   "expect": {
    "js": {
     "kind": "value",
     "value": "STRASSE"
    },
    "python": {
     "kind": "value",
     "value": "STRASSE"
    },
    "dotnet": {
     "kind": "value",
     "value": "STRAßE"
    }
   },
   "note": "Special case mapping: .NET keeps the sharp s (ToUpperInvariant), JS and Python give SS."
  },
