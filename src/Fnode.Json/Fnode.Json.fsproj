<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Description>JSON adapter for Fnode, built on Fergi.Json.JsonValue with source positions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Convert.fs" />
    <Compile Include="JsonFormat.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fnode/Fnode.fsproj" />
    <ProjectReference Include="../JsonValue/JsonValue.fsproj" />
  </ItemGroup>
</Project>
