<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Description>YAML adapter for Fnode, built on FSharp.Data.YamlValue. Parse results carry source locations and original timestamp text.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Convert.fs" />
    <Compile Include="YamlFormat.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Data.YamlValue" Version="0.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fnode/Fnode.fsproj" />
  </ItemGroup>
</Project>
