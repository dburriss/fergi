<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Fergi.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>The fergi command line: validate and run mapping files. .NET only (it references Fergi.Jsonata).</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="Io.fs" />
    <Compile Include="Shared.fs" />
    <Compile Include="ValidateCli.fs" />
    <Compile Include="RunCli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" Version="6.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fergi/Fergi.fsproj" />
    <ProjectReference Include="../Fergi.Jsonata/Fergi.Jsonata.fsproj" />
    <ProjectReference Include="../Fnode.Yaml/Fnode.Yaml.fsproj" />
    <ProjectReference Include="../Fnode.Json/Fnode.Json.fsproj" />
  </ItemGroup>
</Project>
