<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Fergi.Json</RootNamespace>
    <AssemblyName>JsonValue</AssemblyName>
    <Description>Dependency-free, Fable-safe, position-aware untyped JSON document API (strict RFC 8259).</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="JsonValue.fs" />
    <Compile Include="JsonExtensions.fs" />
    <Compile Include="JsonBuilders.fs" />
  </ItemGroup>
</Project>
