<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Flexi.Json and Flexi.Yaml 0.1.0 need FSharp.Core 10.1.403, newer than the one this SDK implies. -->
    <FSharpCoreImplicitPackageVersion>10.1.403</FSharpCoreImplicitPackageVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- The one place the version of the Fergi packages (Fergi, Fergi.Jsonata, Fergi.Tool) is set.
         scripts/publish.fsx rewrites <Version> and <PackageReleaseNotes> here and nowhere else, so both must stay in the
         first PropertyGroup. Projects that set their own <Version> (Fnode.fsproj) keep it. -->
    <Version>0.1.1-alpha1</Version>
    <PackageReleaseNotes>`fergi` command line, packaged as the .NET tool `Fergi.Tool` (needs the .NET 8 runtime or newer): `validate` and
`Fergi` library: mapping builders, plans, policies and errors with positions, over the `Fnode` document core.
JSONata computed values and `ensure` predicates for mappings, bundled in `Fergi.Tool` (`Fergi.Jsonata` is not published yet).
Releases are tag-driven: a `v*` tag publishes `Fergi` and `Fergi.Tool` to NuGet through Trusted Publishing.</PackageReleaseNotes>
    <FergiVersion>$(Version)</FergiVersion>
  </PropertyGroup>
</Project>